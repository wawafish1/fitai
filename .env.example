# The browser calls the same-origin endpoint by default.
VITE_AI_MEAL_ENDPOINT=/api/analyze-meal

# Public deployment
APP_ORIGIN=https://app.fitai.website
PORT=3000
DATA_DIR=/app/data
TRUST_PROXY=1
SESSION_SECRET=replace-with-a-long-random-value
SESSION_DAYS=30
DAILY_ANALYSIS_LIMIT=10
LOGIN_CODE_EXPIRY_MINUTES=10

# Tencent Cloud SES (Hong Kong). Keep credentials server-only.
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_FROM=轻盈计划 <noreply@mail.fitai.website>
TENCENT_SES_TEMPLATE_ID=217461
TENCENT_SES_SUBJECT=轻盈计划登录验证码
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=

# AI relay. Never expose AI_API_KEY through a VITE_ variable.
AI_API_URL=https://yuangeluyou.com/v1/chat/completions
AI_MODEL=gpt-5.6-terra:stable
AI_API_KEY=
